{
  "name": "diamond-protocol",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.app.json && tsc -p ../netlify/tsconfig.json && npm test && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.app.json && tsc -p ../netlify/tsconfig.json",
    "test": "tsx --test tests/all.test.ts"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vite": "^7.3.6"
  }
}
