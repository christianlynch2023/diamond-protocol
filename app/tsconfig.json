{
  // STRICT check for the pure logic: lib/, data/ and the shared types. No React here.
  // Screens and App are checked by tsconfig.app.json (looser, for now).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "strict": true,
    "types": []
  },
  "include": ["src/lib", "src/data", "src/types.ts"]
}
