{
  // Phase 3b: lib/ and data/ are TypeScript under full strict mode.
  // Screens (.jsx) are not type-checked yet (checkJs: false); they move to TypeScript next.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "strict": true,
    "types": []
  },
  "include": ["src"]
}
